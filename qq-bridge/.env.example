# ===== 必填 =====
# 你本人的 QQ 号（只有这个号发消息才会被回复，其他人一律忽略）
OWNER_QQ=

# DeepSeek 官方 API Key（sk- 开头）
DEEPSEEK_API_KEY=

# ===== 选填 =====
# NapCat 的 OneBot WebSocket 地址
NAPCAT_WS=ws://127.0.0.1:3001

# 如果 NapCat 里给 WS 服务端设了 Token，填这里（没有就留空）
NAPCAT_TOKEN=

# 模型
MODEL=deepseek-chat
DEEPSEEK_BASE=https://api.deepseek.com

# 每分钟最多发几条，防封号
MAX_MSG_PER_MIN=6
# 掉线自动重新登录（可选）：填了小号密码就不必每次扫码
NAPCAT_QUICK_ACCOUNT=
NAPCAT_QUICK_PASSWORD=
# 也可以用 32 位 MD5 代替明文：
NAPCAT_QUICK_PASSWORD_MD5=
# NapCat 重启冷却（分钟），避免掉线时反复重启
NAPCAT_RETRY_COOLDOWN=12
